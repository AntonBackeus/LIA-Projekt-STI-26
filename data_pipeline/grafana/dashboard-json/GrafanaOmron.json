            "type": "grafana-postgresql-datasource",
            "uid": "P90F691777F0F6697"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  Category,\n  Meaning,\n  \"time\"\nFROM (\n  SELECT\n    DISTINCT ON (enriched_data->>'Category')\n    ts AS \"time\",\n    enriched_data->>'Category' as \"Category\",\n    enriched_data->>'Meaning' as \"Meaning\"\n  FROM robot_status_events\n  WHERE\n    $__timeFilter(ts) AND\n    ($__robot_address_all OR robot_address = '${robot:csv}') AND\n    enriched_data->>'Type' = 'STATE'\n  ORDER BY\n    enriched_data->>'Category', ts DESC\n) AS latest_states\nORDER BY Category",
          "refId": "A"
        }
      ],
      "title": "Current Robot Status",
      "type": "table"
    }
