          "rawQuery": true,
          "rawSql": "SELECT\n  ts AS \"time\",\n  enriched_data->>'Meaning' AS \"Meaning\",\n  enriched_data->>'Category' AS \"Category\",\n  raw_message AS \"Raw Message\"\nFROM robot_status_events\nWHERE\n  $__timeFilter(ts) AND\n  ($__robot_address_all OR robot_address = '${robot:csv}') AND\n  enriched_data->>'Type' != 'SENSOR_READING'\nORDER BY ts DESC\nLIMIT 500",
