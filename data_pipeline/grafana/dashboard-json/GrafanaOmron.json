          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  time_bucket('1m', ts) AS \"time\",\n  enriched_data->>'Category' AS metric,\n  COUNT(*)\nFROM robot_status_events\nWHERE\n  $__timeFilter(ts) AND\n  ($__robot_address_all OR robot_address = '${robot:csv}') AND\n  enriched_data->>'Type' = 'ERROR'\nGROUP BY 1, 2\nORDER BY 1",
